{
  "manifest_version": 3,
  "name": "Pancake New Message Watcher",
  "version": "0.6.0",
  "description": "Theo dõi danh sách hội thoại trên pancake.vn để phát hiện tin nhắn mới.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://pancake.vn/*", "http://localhost:8787/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pancake.vn/*"],
      "js": ["content.js", "panel.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pancake Watcher"
  }
}
