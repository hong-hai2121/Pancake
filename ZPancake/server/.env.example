# Copy file này thành .env (cùng thư mục) rồi chỉnh lại — .env đã được
# .gitignore bỏ qua, không commit lên git.

# Cách quét cảm xúc tiêu cực trong snippet tin nhắn: "keyword" hoặc "llm".
# - keyword: khớp danh sách từ khoá tiếng Việt trong sentiment.py, offline,
#   không cần key, độ chính xác giới hạn.
# - llm: gọi OpenAI (gpt-4o-mini) để phân loại, chính xác hơn nhưng cần
#   OPENAI_API_KEY bên dưới + tốn phí nhỏ mỗi lần gọi + cần internet.
SENTIMENT_METHOD=keyword

# Chỉ cần khi SENTIMENT_METHOD=llm. Key riêng cho ZPancake — KHÔNG dùng chung
# với OPENAI_API_KEY của dự án app/ ở thư mục gốc repo (2 dự án độc lập).
OPENAI_API_KEY=

# Thông báo Telegram khi phát hiện khách hàng "negative" (tuỳ chọn) — bỏ
# trống 1 trong 2 dòng dưới thì tắt hẳn tính năng này, không gửi gì cả.
#
# Cách lấy TELEGRAM_BOT_TOKEN:
#   1. Mở Telegram, tìm chat với @BotFather.
#   2. Gõ /newbot, đặt tên rồi đặt username (phải kết thúc bằng "bot").
#   3. BotFather trả về 1 chuỗi dạng "123456789:AAExxxxxxxxxxxxxxxxxxxxxxx" —
#      copy nguyên chuỗi đó vào đây.
#
# Cách lấy TELEGRAM_CHAT_ID:
#   1. Mở chat với bot vừa tạo (link BotFather gửi kèm lúc /newbot xong),
#      bấm Start rồi nhắn 1 tin bất kỳ (vd "hi").
#   2. Mở trình duyệt, vào:
#      https://api.telegram.org/bot<TOKEN vừa copy ở trên>/getUpdates
#   3. Tìm số ở "chat":{"id": ...} trong kết quả JSON trả về — copy số đó
#      (không có dấu ngoặc kép) vào đây.
#   4. Nếu muốn nhận vào 1 nhóm thay vì chat riêng: thêm bot vào nhóm đó, gửi
#      1 tin trong nhóm, chat_id lúc này là số ÂM (vd "-1001234567890").
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
