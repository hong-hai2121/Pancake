# ================= Pancake =================
PANCAKE_ACCESS_TOKEN=        # Access token (JWT) lấy từ Pancake POS
# PANCAKE_BASE_URL=https://pages.fm/api/v1   # tùy chọn, đã có default trong config

# ================= Facebook Messenger =================
FB_PAGE_ACCESS_TOKEN=        # Page access token lấy từ Meta for Developers
FB_VERIFY_TOKEN=             # Chuỗi tự đặt, dùng để verify webhook (GET)
FB_APP_SECRET=               # App secret, dùng để xác thực chữ ký X-Hub-Signature

# ================= LLM =================
LLM_PROVIDER=gemini          # gemini | openai
GEMINI_API_KEY=
OPENAI_API_KEY=

# ================= Embedding =================
EMBEDDING_PROVIDER=gemini    # gemini | openai
EMBEDDING_MODEL=text-embedding-004   # gemini: text-embedding-004 (768d) | openai: text-embedding-3-small (1536d)

# ================= Supabase / Postgres =================
SUPABASE_URL=
SUPABASE_KEY=                # service_role key (chạy phía server)
DATABASE_URL=postgresql://user:password@host:5432/dbname
