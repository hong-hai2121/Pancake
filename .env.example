# ================= Pancake =================
PANCAKE_ACCESS_TOKEN=        # Access token (JWT) lấy từ Pancake POS
# PANCAKE_BASE_URL=https://pages.fm/api/v1   # tùy chọn, đã có default trong config

# Lọc hội thoại theo thẻ (tên + màu thật) ở màn Tin nhắn — dùng public API.
# Cách 1 (tự động): liệt kê page_id (phân tách bởi dấu phẩy) vào PANCAKE_TAG_PAGE_IDS;
#   app sẽ TỰ SINH page_access_token (cần token Pancake quyền Admin) và tự ghi vào
#   PANCAKE_PAGE_TOKENS bên dưới để lần sau tái dùng.
# PANCAKE_TAG_PAGE_IDS=1001086139761206
# Cách 2 (điền tay): dán sẵn JSON map {page_id: page_access_token}.
#   Thiếu page nào thì màn Tin nhắn tự hiện "Thẻ #id" cho page đó.
# PANCAKE_PAGE_TOKENS={"1001086139761206":"xxxxx"}

# ================= Facebook Messenger =================
FB_PAGE_ACCESS_TOKEN=        # Page access token lấy từ Meta for Developers
FB_VERIFY_TOKEN=             # Chuỗi tự đặt, dùng để verify webhook (GET)
FB_APP_SECRET=               # App secret, dùng để xác thực chữ ký X-Hub-Signature

# ================= LLM =================
LLM_PROVIDER=gemini          # gemini | openai
GEMINI_API_KEY=
OPENAI_API_KEY=

# ================= Embedding =================
EMBEDDING_PROVIDER=gemini    # gemini | openai
EMBEDDING_MODEL=text-embedding-004   # gemini: text-embedding-004 (768d) | openai: text-embedding-3-small (1536d)

# ================= Worker nền (app/workers/) =================
# Chạy suốt lúc server sống, KHÔNG cần mở trình duyệt.
#  - poller: mỗi INBOX_POLL_INTERVAL giây kéo INBOX_POLL_LIMIT hội thoại mới nhất
#    của TỪNG page đang BẬT về bảng watcher.hoi_thoai (1 request/page/vòng).
#  - sentiment: quét cảm xúc tiêu cực cho hội thoại mới, dùng chung keywords.json
#    + Telegram của ZPancake.
INBOX_POLL_ENABLED=true
# Nhịp THÍCH ỨNG từng page: có tin mới -> hỏi lại sau INTERVAL giây; im lặng thì
# giãn gấp đôi mỗi lượt tới trần MAX_INTERVAL. Page bận vẫn nhanh, page ế không
# đốt quota (Pancake trả 429 khá sớm).
INBOX_POLL_INTERVAL=20
INBOX_POLL_MAX_INTERVAL=300
# Mỗi lượt chỉ xin LIMIT_SMALL hội thoại; nghi có sót (mọi dòng trả về đều mới
# hơn mốc đã biết) mới xin thêm theo LIMIT rồi LIMIT_MAX.
INBOX_POLL_LIMIT_SMALL=5
INBOX_POLL_LIMIT=20
INBOX_POLL_LIMIT_MAX=50
# Ngắt mạch: page lỗi liên tiếp ngần này lượt (bị Pancake vô hiệu hoá, mất
# quyền...) thì nghỉ ERROR_BACKOFF giây mới thử lại.
INBOX_POLL_ERROR_THRESHOLD=3
INBOX_POLL_ERROR_BACKOFF=1800
SENTIMENT_ENABLED=true
SENTIMENT_INTERVAL=8
SENTIMENT_BATCH=10
# Báo Telegram khi phát hiện hội thoại tiêu cực. Thiếu 1 trong 2 dòng = TẮT hẳn
# (không gửi gì, cũng không báo lỗi). Cách lấy 2 giá trị: xem ZPancake/server/.env.example
#   1. Chat với @BotFather -> /newbot -> lấy token dạng "123456789:AAE..."
#   2. Nhắn 1 tin cho bot vừa tạo rồi mở
#      https://api.telegram.org/bot<TOKEN>/getUpdates -> lấy số ở "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ================= Nơi lưu dữ liệu =================
# postgres = Postgres + pgvector cài trên máy này | supabase = Postgres cloud.
# Đổi qua lại chỉ cần sửa dòng này rồi khởi động lại app (không đụng code).
DB_BACKEND=postgres

# --- khi DB_BACKEND=postgres ---
# Postgres phải có extension pgvector (image pgvector/pgvector:pg17 đã có sẵn).
# Bảng + index HNSW TỰ TẠO ở lần chạy đầu, không phải chạy tay file SQL nào.
# Dùng 127.0.0.1 chứ KHÔNG phải localhost: Docker chỉ nghe trên IPv4, còn
# localhost trên Windows phân giải ra ::1 trước -> kết nối treo.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pancakebot
# PG_POOL_MIN=1
# PG_POOL_MAX=10

# --- khi DB_BACKEND=supabase ---
SUPABASE_URL=
SUPABASE_KEY=                # secret key sb_secret_... (chạy phía server)
