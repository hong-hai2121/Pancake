# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# File dữ liệu tạm / cục bộ (không đẩy lên git)
pancake_tags_sample.json
page_switches.json
# Công tắc BẬT/TẮT worker quét cảm xúc (đổi từ trang /cam-xuc)
sentiment_switch.json

# ZPancake/server: SQLite DB local, không đẩy lên git
ZPancake/server/data/*.db
ZPancake/server/data/*.db-journal
ZPancake/server/server.pid

# DB_BACKEND=postgres: dữ liệu nằm trong volume Docker `pgdata`, không có file
# nào trong repo. Dump tay (pg_dump) thì để ở đây và cũng không đẩy lên git.
data/*.dump
data/*.sql

# File .db của backend sqlite CŨ (đã bỏ) — giữ tạm để chép dữ liệu sang Postgres
data/*.db
data/*.db-wal
data/*.db-shm

# Trang web đã lưu về máy để tham khảo, chỉ dùng cục bộ
web-da-noi/

# Template mẫu (PHP) chỉ dùng để tham khảo giao diện, không đẩy lên git
templatemaux/
